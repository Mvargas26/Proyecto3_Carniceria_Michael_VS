@using MVC_Carniceria.Models
@model List<FacturaViewModel>

@{
    ViewData["Title"] = "Reporte de Ventas Semanales";
    DateTime inicioSemana = ViewBag.InicioSemana ?? DateTime.Today;
    DateTime finSemana = ViewBag.FinSemana ?? DateTime.Today;
    decimal totalVendidoSemana = ViewBag.TotalVendidoSemana ?? 0m;
}

@section Styles {
    <link rel="stylesheet" href="~/css/Factura/listarFacturas.css" asp-append-version="true" />
}

<div class="page-header">
    <div>
        <h1>Reporte de Ventas Semanales</h1>
        <p>
            Facturas en estado <strong>Pagada</strong> correspondientes a la semana actual (Lunes a Domingo):
            <strong>@inicioSemana.ToString("dd/MM/yyyy")</strong> al <strong>@finSemana.ToString("dd/MM/yyyy")</strong>.
        </p>
        <br />
        <div class="alert alert-success d-inline-block mb-0 py-2 px-3">
            <i class="bi bi-cash-coin me-1"></i>
            Monto Total Vendido en la Semana: <strong>₡@totalVendidoSemana.ToString("N2")</strong>
        </div>
    </div>

    <a asp-action="ListarFacturas" class="btn btn-secondary">
        <i class="bi bi-arrow-left me-1"></i> Volver a Facturas
    </a>
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <i class="bi bi-graph-up-arrow"></i>
        <h3>No hay ventas pagadas en la semana actual</h3>
        <p>No se encontraron facturas en estado Pagada entre el @inicioSemana.ToString("dd/MM/yyyy") y el @finSemana.ToString("dd/MM/yyyy").</p>
    </div>
}
else
{
    <div class="table-wrapper">
        <table class="table">
            <thead>
                <tr>
                    <th>N° Factura</th>
                    <th>Fecha y Hora</th>
                    <th>Cliente</th>
                    <th>Empleado</th>
                    <th>Subtotal</th>
                    <th>Descuento</th>
                    <th>IVA (13%)</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var factura in Model)
                {
                    <tr>
                        <td><strong>@factura.NumeroFactura</strong></td>
                        <td>@factura.Fecha.ToString("dd/MM/yyyy HH:mm:ss")</td>
                        <td>@factura.NombreCliente</td>
                        <td>@factura.NombreEmpleado</td>
                        <td>₡@factura.Subtotal.ToString("N2")</td>
                        <td>₡@factura.MontoDescuento.ToString("N2") (@factura.PorcentajeDescuento.ToString("0.##")%)</td>
                        <td>₡@factura.Impuesto.ToString("N2")</td>
                        <td><strong>₡@factura.Total.ToString("N2")</strong></td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="7" class="text-end"><strong>Total Vendido (Semana Actual):</strong></td>
                    <td colspan="2"><strong>₡@totalVendidoSemana.ToString("N2")</strong></td>
                </tr>
            </tfoot>
        </table>
    </div>
}